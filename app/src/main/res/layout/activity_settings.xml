<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/colorSurface">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_back"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="模型、执行能力与权限"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp">

        <!-- AI 配置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 大脑配置"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="-0.01"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="选择厂商并填入 API Key"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="① 厂商"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorTextSecondary" />

            <Spinner
                android:id="@+id/spinnerVendor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_settings_input" />

            <TextView
                android:id="@+id/tvKeyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/colorPrimary"
                android:lineSpacingExtra="3dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="② 接口地址"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorTextSecondary" />

            <EditText
                android:id="@+id/etBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:inputType="textUri"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_settings_input"
                android:hint="https://api.deepseek.com/v1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="③ 模型名"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorTextSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <AutoCompleteTextView
                    android:id="@+id/etModel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_settings_input"
                    android:hint="deepseek-chat" />

                <Button
                    android:id="@+id/btnFetchModels"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="拉取"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_section_button"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="④ API Key"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorTextSecondary" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:paddingStart="12dp"
                    android:paddingEnd="52dp"
                    android:background="@drawable/bg_settings_input"
                    android:hint="粘贴你的 API Key" />

                <ImageView
                    android:id="@+id/toggleApiKey"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye_off"
                    android:contentDescription="显示或隐藏 API Key"
                    android:background="@drawable/bg_eye_button" />
            </FrameLayout>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="保存设置"
                android:textColor="@color/colorOnPrimary"
                android:textSize="15sp"
                android:background="@drawable/bg_send_button" />
        </LinearLayout>

        <!-- 思考过程卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="思考过程"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="-0.01"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="看清 AI 每一步在想什么，方便判断它为什么点错"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="显示思考过程"
                        android:textSize="15sp"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="在聊天里默认展开，手机重开 App 后仍可见，点气泡可收起"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <com.aibutler.app.JellyToggle
                    android:id="@+id/swShowThinking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="深度思考模式"
                        android:textSize="15sp"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="开启后先推理再动手，才能看到完整思考过程；关闭可提速但可能不再返回思考"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <com.aibutler.app.JellyToggle
                    android:id="@+id/swDeepThink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- AutoGLM-Phone 手机脑 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AutoGLM-Phone 手机脑（看截图操控）"
                    android:textStyle="bold"
                    android:textSize="18sp"
                android:letterSpacing="-0.01"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="开启后由智谱 AutoGLM-Phone 看截图决策，适合抖音/小红书这类自绘界面；需把上方厂商选为「智谱 GLM」。关闭则用控件树大脑（省流量，文字类任务更稳）"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <com.aibutler.app.JellyToggle
                android:id="@+id/swAutoGlm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 开放式任务挂机上限 -->
        <LinearLayout
            android:id="@+id/rowSessionCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开放式任务挂机上限"
                    android:textStyle="bold"
                    android:textSize="18sp"
                android:letterSpacing="-0.01"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="「刷视频赚金币」这类不说停的任务，每挂机这么久问一次要不要继续；不点就默认继续"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSessionCapValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30分钟"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary" />
        </LinearLayout>

        <!-- 开发者模式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开发者模式"
                        android:textStyle="bold"
                        android:textSize="18sp"
                android:letterSpacing="-0.01"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tvExperienceSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="在设置页查看正确和错误行为"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <com.aibutler.app.JellyToggle
                    android:id="@+id/swDeveloperMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDeveloperPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFilterAllExperience"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="全部"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_developer_filter_selected"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnFilterSuccessExperience"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="正确"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_developer_filter_unselected"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnFilterFailureExperience"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="错误"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_developer_filter_unselected"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <com.aibutler.app.GestureLockScrollView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/developer_list_height"
                    android:layout_marginTop="6dp"
                    android:background="@color/colorSoftField"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="true">

                    <LinearLayout
                        android:id="@+id/llExperienceList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.aibutler.app.GestureLockScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="这些记录可直接编辑/删除，帮 AI 复用成功经验、避开失败走法"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextHint"
                    android:lineSpacingExtra="3dp" />

                <Button
                    android:id="@+id/btnClearExperience"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="清空全部记录（需确认）"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@drawable/bg_neutral_button"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 权限卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="权限设置"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="-0.01"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="让 AI 能真正帮你干活"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/tvPermStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btnA11y"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="开启「无障碍·自动执行」（必开）"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:background="@drawable/bg_neutral_button"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnNotif"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="允许读取通知（帮你看新消息）"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:background="@drawable/bg_neutral_button"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- 安全卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="安全"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="-0.01"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="锁屏 PIN 码（自动亮屏解锁用）"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="输入 PIN 数字密码，留空不自动解锁"
                    android:inputType="numberPassword"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:maxLength="16"
                    android:paddingStart="12dp"
                    android:paddingEnd="52dp"
                    android:background="@drawable/bg_settings_input" />

                <ImageView
                    android:id="@+id/togglePin"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye_off"
                    android:contentDescription="显示或隐藏 PIN 码"
                    android:background="@drawable/bg_eye_button" />
            </FrameLayout>

            <Button
                android:id="@+id/btnSavePin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="保存 PIN 码（只存本机）"
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:background="@drawable/bg_section_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="13sp"
                android:textColor="@color/colorTextHint"
                android:lineSpacingExtra="4dp"
                android:text="提示：无障碍服务是 AI 替你操作的核心能力。涉及付款、转账的确认步骤，AI 不会替你点，最后一步由你手动确认。" />
        </LinearLayout>

        <!-- 关于卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="-0.01"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>


