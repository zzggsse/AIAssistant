<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_assistant_one"
        android:theme="@style/Theme.AssistantOne"
        android:usesCleartextTraffic="true">

        <!-- 注意：这里曾有指向 .MainActivity 的 LAUNCHER 入口，但该类并不存在，
             装上后点桌面图标必崩 ClassNotFoundException，已移除。
             本模块定位是无障碍执行测试壳，如需界面请补齐类后再加回入口。 -->

        <service
            android:name=".AssistantOneAccessibilityService"
            android:exported="false"
            android:label="助手1 · 无障碍执行"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
